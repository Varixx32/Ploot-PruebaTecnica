# Template only. Run `./scripts/init-env.sh` to create .env with every secret generated randomly.
# Secrets are left empty on purpose: they never live in the repo. Deployments set them in the host.

# --- Postgres ---
POSTGRES_USER=ploot
POSTGRES_DB=ploot
# Host port (5433 to avoid clashing with a local Postgres on 5432)
POSTGRES_PORT=5433
POSTGRES_PASSWORD=

# --- Runtime DB users (created by the `setup` service) ---
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=

# --- Token vault: "version:base64(32 bytes)", comma-separated; highest version encrypts ---
TOKEN_ENC_KEYS=

# --- JWT signing secret for test tokens (HS256, >= 32 chars) ---
JWT_SECRET=

# --- Provider mock ---
MOCK_PORT=4000
# Initial fixture tokens are derived from this (shared by the mock and the seed).
MOCK_FIXTURE_SECRET=
# Required header value for /__admin/* on the mock.
MOCK_ADMIN_KEY=
# Chaos knobs (see mock/README.md). Defaults follow the provider contract: 0–3 s latency.
MOCK_LATENCY_MAX_MS=3000
MOCK_5XX_RATE=0.1
MOCK_ACCESS_TOKEN_TTL_SEC=600
MOCK_USER_RL_CAPACITY=3
MOCK_USER_RL_REFILL_PER_SEC=0.05
MOCK_APP_RL_CAPACITY=20
MOCK_APP_RL_REFILL_PER_SEC=2

# --- Worker ---
WORKER_REPLICAS=2
# Spacing between two posts of the same Embajador (provider refills 1 post / 20 s per user).
WORKER_AMBASSADOR_MIN_INTERVAL_SEC=25
# Shared app budget, kept below the provider's app limit (20 burst, 2/s).
WORKER_APP_RATE_CAPACITY=10
WORKER_APP_RATE_REFILL_PER_SEC=1.5
WORKER_GLOBAL_MAX_IN_FLIGHT=20
WORKER_TENANT_MAX_IN_FLIGHT=5

# --- App (Next.js) ---
APP_PORT=3000
APP_DB_POOL_MAX=5
# Demo-only: /api/demo/login issues 1 h tokens for the seeded profiles.
DEMO_LOGIN_ENABLED=true
