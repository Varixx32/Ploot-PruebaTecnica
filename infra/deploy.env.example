# Template for .env.deploy (gitignored). Used ONLY by scripts/deploy-db.sh from your machine or
# a CI job with protected secrets. Never commit real values.

# Neon DIRECT connection (not the -pooler host): migrations need a session for the advisory lock.
# Owner role from the Neon console. Keep ?sslmode=require.
DATABASE_URL=

# Passwords for the runtime login roles created by the script (generate: openssl rand -hex 24).
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=

# Must match the values configured in Railway (worker / mock).
TOKEN_ENC_KEYS=
MOCK_FIXTURE_SECRET=
