{
  "name": "@ploot/worker",
  "private": true,
  "description": "Long-lived publisher process: claims due posts and publishes them against the provider",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "why": "tsx --env-file-if-exists=../.env src/why.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ploot/db": "*",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
